generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Curriculo {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  telefone    String?
  resumo      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}